{"type":"text","id":"ev_adb_t","x":2056,"y":1538,"width":880,"height":179,"text":"// AdbHelper.broadcast_app_function(domain='NOTES', action='findNotes')   (illustrative)\n$ adb -s $S25 shell am broadcast --receiver-include-background \\\n    -n com.samsung.xr.claw.client/.AppFunctionTestReceiver \\\n    -a com.samsung.xr.claw.client.TEST_APP_FUNCTION \\\n    --es domain 'NOTES' --es action 'findNotes'\n\n$ adb logcat -d -s claw.AFN_TEST:I        # polled every 0.5 s until DONE\nclaw.AFN_TEST: RESULT id=\"42\" title=\"Shopping List\" content=\"milk\\neggs\"\nclaw.AFN_TEST: DONE\n\n// _parse_notes(): regex key=\"value\" + unescape_logcat_value  →  NoteItem.to_dict()","originalText":"// AdbHelper.broadcast_app_function(domain='NOTES', action='findNotes')   (illustrative)\n$ adb -s $S25 shell am broadcast --receiver-include-background \\\n    -n com.samsung.xr.claw.client/.AppFunctionTestReceiver \\\n    -a com.samsung.xr.claw.client.TEST_APP_FUNCTION \\\n    --es domain 'NOTES' --es action 'findNotes'\n\n$ adb logcat -d -s claw.AFN_TEST:I        # polled every 0.5 s until DONE\nclaw.AFN_TEST: RESULT id=\"42\" title=\"Shopping List\" content=\"milk\\neggs\"\nclaw.AFN_TEST: DONE\n\n// _parse_notes(): regex key=\"value\" + unescape_logcat_value  →  NoteItem.to_dict()","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":50072,"version":1,"versionNonce":50072,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
